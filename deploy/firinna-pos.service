[Unit]
Description=Firinna POS System
After=network.target

[Service]
User=turan
WorkingDirectory=/opt/firinna-pos
Environment="PATH=/opt/firinna-pos/venv/bin"
ExecStart=/opt/firinna-pos/venv/bin/gunicorn -w 4 -b 127.0.0.1:5001 --timeout 120 app:app

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
